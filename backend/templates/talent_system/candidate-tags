<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Candidate Tags - Lumina AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white min-h-screen">

<nav class="fixed left-0 top-0 h-full w-[220px] bg-gray-900 border-r border-gray-800 flex flex-col py-8 px-4 z-50">
    <h1 class="text-purple-400 font-bold text-lg mb-8">Lumina AI</h1>
    <a href="/dashboard"          class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">📊 Dashboard</a>
    <a href="/upload"             class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">📤 Upload Resume</a>
    <a href="/screening"          class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">🔍 AI Screening</a>
    <a href="/candidates"         class="flex items-center gap-3 text-white px-3 py-2 rounded-lg bg-purple-500/20 border-l-4 border-purple-400 mb-1">👥 Candidates</a>
    <a href="/candidate-tags"     class="flex items-center gap-3 text-gray-300 px-3 py-2 rounded-lg hover:bg-white/5 mb-1 ml-4 text-sm">🏷️ Tags</a>
    <a href="/compare-candidates" class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">⚖️ Compare</a>
    <a href="/history"            class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">🕐 History</a>
    <a href="/analytics"          class="flex items-center gap-3 text-gray-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 mb-1">📈 Analytics</a>
    <a href="/logout"             class="flex items-center gap-3 text-red-400 hover:text-red-300 px-3 py-2 rounded-lg hover:bg-red-500/10 mt-auto">🚪 Logout</a>
</nav>

<main class="ml-[220px] p-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold">Candidate Tags</h1>
        <p class="text-gray-400 mt-1">Organize and filter candidates using custom tags</p>
    </div>

    <!-- CREATE TAG -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 mb-6">
        <h3 class="font-bold text-lg mb-4">Create New Tag</h3>
        <div class="flex gap-4">
            <input id="tagName" type="text" placeholder="Tag name (e.g. Top Candidate, Python Expert)"
                class="flex-1 bg-gray-800 border border-gray-700 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-purple-500"/>
            <select id="tagColor" class="bg-gray-800 border border-gray-700 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-purple-500">
                <option value="purple">Purple</option>
                <option value="blue">Blue</option>
                <option value="green">Green</option>
                <option value="yellow">Yellow</option>
                <option value="red">Red</option>
            </select>
            <button onclick="createTag()" class="bg-purple-600 hover:bg-purple-700 px-6 py-2 rounded-xl font-bold text-sm transition-all">
                + Create Tag
            </button>
        </div>
    </div>

    <!-- EXISTING TAGS -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 mb-6">
        <h3 class="font-bold text-lg mb-4">Active Tags</h3>
        <div id="tagsList" class="flex flex-wrap gap-3">
            <span class="bg-purple-500/20 text-purple-300 border border-purple-500/30 px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                🏷️ Top Candidate <button onclick="this.parentElement.remove()" class="text-purple-400 hover:text-white ml-1">×</button>
            </span>
            <span class="bg-green-500/20 text-green-300 border border-green-500/30 px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                🏷️ Python Expert <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-white ml-1">×</button>
            </span>
            <span class="bg-blue-500/20 text-blue-300 border border-blue-500/30 px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                🏷️ Cloud Specialist <button onclick="this.parentElement.remove()" class="text-blue-400 hover:text-white ml-1">×</button>
            </span>
            <span class="bg-yellow-500/20 text-yellow-300 border border-yellow-500/30 px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                🏷️ Shortlisted <button onclick="this.parentElement.remove()" class="text-yellow-400 hover:text-white ml-1">×</button>
            </span>
            <span class="bg-red-500/20 text-red-300 border border-red-500/30 px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                🏷️ Needs Review <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-white ml-1">×</button>
            </span>
        </div>
    </div>

    <!-- TAGGED CANDIDATES -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-800">
            <h3 class="font-bold text-lg">Candidates by Tag</h3>
        </div>
        <div class="divide-y divide-gray-800">
            <div class="px-6 py-4 flex justify-between items-center hover:bg-white/5 transition-all">
                <div>
                    <p class="font-bold">Jordan Sterling</p>
                    <p class="text-gray-400 text-sm">Cloud Architect</p>
                </div>
                <div class="flex gap-2">
                    <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full text-xs">Top Candidate</span>
                    <span class="bg-blue-500/20 text-blue-300 px-3 py-1 rounded-full text-xs">Cloud Specialist</span>
                </div>
                <a href="/candidate-profile" class="text-purple-400 hover:underline text-sm">View →</a>
            </div>
            <div class="px-6 py-4 flex justify-between items-center hover:bg-white/5 transition-all">
                <div>
                    <p class="font-bold">Alex Kumar</p>
                    <p class="text-gray-400 text-sm">Backend Engineer</p>
                </div>
                <div class="flex gap-2">
                    <span class="bg-green-500/20 text-green-300 px-3 py-1 rounded-full text-xs">Python Expert</span>
                    <span class="bg-yellow-500/20 text-yellow-300 px-3 py-1 rounded-full text-xs">Shortlisted</span>
                </div>
                <a href="/candidate-profile" class="text-purple-400 hover:underline text-sm">View →</a>
            </div>
            <div class="px-6 py-4 flex justify-between items-center hover:bg-white/5 transition-all">
                <div>
                    <p class="font-bold">Sarah Jenkins</p>
                    <p class="text-gray-400 text-sm">Frontend Developer</p>
                </div>
                <div class="flex gap-2">
                    <span class="bg-red-500/20 text-red-300 px-3 py-1 rounded-full text-xs">Needs Review</span>
                </div>
                <a href="/candidate-profile" class="text-purple-400 hover:underline text-sm">View →</a>
            </div>
        </div>
    </div>
</main>

<script>
const colorMap = {
    purple: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
    blue:   'bg-blue-500/20 text-blue-300 border-blue-500/30',
    green:  'bg-green-500/20 text-green-300 border-green-500/30',
    yellow: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
    red:    'bg-red-500/20 text-red-300 border-red-500/30'
};

function createTag() {
    const name = document.getElementById('tagName').value.trim();
    const color = document.getElementById('tagColor').value;
    if (!name) { alert('Enter a tag name'); return; }

    const tag = document.createElement('span');
    tag.className = `${colorMap[color]} border px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2`;
    tag.innerHTML = `🏷️ ${name} <button onclick="this.parentElement.remove()" class="hover:text-white ml-1">×</button>`;
    document.getElementById('tagsList').appendChild(tag);
    document.getElementById('tagName').value = '';
}
</script>
</body>
</html>